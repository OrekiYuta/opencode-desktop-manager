{
  "name": "opencode-desktop-manager",
  "version": "0.1.0",
  "description": "Desktop session manager plugin for OpenCode: session favorites, project grouping, and bulk cleanup.",
  "type": "module",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compile": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "vite --config tests/vite.config.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.6"
  },
  "devDependencies": {
    "effect": "4.1.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrekiYuta/opencode-desktop-manager.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "session-manager",
    "desktop-manager",
    "favorites",
    "desktop"
  ]
}
